{
  "name": "arihant-bos-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter @arihant/api --filter @arihant/web dev",
    "dev:api": "pnpm --filter @arihant/api dev",
    "dev:web": "pnpm --filter @arihant/web dev",
    "build": "pnpm --filter @arihant/shared build && pnpm --filter @arihant/api build && pnpm --filter @arihant/web build",
    "build:web": "pnpm --filter @arihant/shared build && pnpm --filter @arihant/web build",
    "start": "bash scripts/start-all.sh",
    "start:all": "bash scripts/start-all.sh",
    "start:pm2": "pm2 start ecosystem.config.js",
    "stop:pm2": "pm2 stop ecosystem.config.js",
    "typecheck": "pnpm --recursive run typecheck",
    "lint": "pnpm --recursive run lint",
    "seed": "pnpm --filter @arihant/api seed",
    "seed:module5": "pnpm --filter @arihant/api seed:module5",
    "test:e2e": "pnpm --filter @arihant/api test:e2e",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:init": "docker exec -i arihant_bos_db psql -U postgres -d postgres < db/schema.sql && docker exec -i arihant_bos_db psql -U postgres -d postgres < db/migrations/001_local_auth.sql",
    "db:migrate": "pnpm --filter @arihant/api migrate",
    "db:migrate:prod": "pnpm --filter @arihant/api migrate:prod"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "bcrypt",
      "@nestjs/core",
      "@swc/core",
      "sharp"
    ]
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
