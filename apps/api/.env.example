# Runtime
NODE_ENV=development
PORT=4000
WS_PORT=4001
CORS_ORIGINS=http://localhost:3000

# Postgres direct connection for Kysely
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Supabase Auth configuration
SUPABASE_URL=https://dummy.supabase.co
SUPABASE_SERVICE_ROLE_KEY=dummy-service-role-key
SUPABASE_ANON_KEY=dummy-anon-key
SUPABASE_JWT_SECRET=super-secret-supabase-jwt-token-key-32chars

# Cloudinary
CLOUDINARY_CLOUD_NAME=arihant-trading
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=abcdefghijklmnopqrstuvwxyz12345
CLOUDINARY_UPLOAD_FOLDER=arihant-bos

# Auth / security
ACCESS_TOKEN_TTL_MIN=60
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX=120

# Jobs (cron)
APP_TIMEZONE=Asia/Kolkata
TENDER_DEADLINE_WARN_DAYS=7

# Demo persona sign-in (POST /auth/demo-login, used by the login page's quick profiles).
# On in every environment, production included; set to false to turn it off.
# While on, anyone who opens the login page can sign in as the seeded demo accounts (admin included) without a password.
DEMO_LOGIN_ENABLED=true
