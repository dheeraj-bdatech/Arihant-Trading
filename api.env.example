# ==============================================================
# Arihant BOS — API (NestJS)   →  copy to apps/api/.env
# Never commit the real .env. This file ships placeholders only.
# ==============================================================

# ---- Runtime ----
NODE_ENV=development
PORT=4000
# comma-separated origins allowed to call the API (the web app + local)
CORS_ORIGINS=http://localhost:3000

# ---- Supabase (Project → Settings → API) ----
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# service_role key: SERVER-ONLY. Bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# anon key (used only if the API ever needs the public client)
SUPABASE_ANON_KEY=your-anon-key
# JWT secret used to VERIFY incoming Supabase tokens
# (Settings → API → JWT Settings → JWT Secret)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ---- Postgres direct connection for Kysely ----
# Use the POOLER connection string (Settings → Database → Connection pooling,
# Mode: Transaction) — not the direct 5432 URL — for serverless/pooled access.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct (non-pooled) URL — used ONLY by migrations / seed / kysely-codegen
DIRECT_URL=postgresql://postgres:YOUR-DB-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# ---- Cloudinary (Dashboard → Product Environment Credentials) ----
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
# SERVER-ONLY. Used to sign uploads. Never send to the client.
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_UPLOAD_FOLDER=arihant-bos

# ---- WebSockets ----
WS_PORT=4001
# (optional) Redis URL for the Socket.IO adapter if you scale to >1 API instance
# REDIS_URL=redis://localhost:6379

# ---- Auth / security ----
# minutes an access token stays valid on the client before refresh
ACCESS_TOKEN_TTL_MIN=60
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX=120

# ---- Jobs (cron) ----
# IANA timezone used for "due today" / deadline calculations
APP_TIMEZONE=Asia/Kolkata
# how many days before bid_closing_date to raise a deadline notification
TENDER_DEADLINE_WARN_DAYS=7

# Module 9 — Expense Management (all optional; defaults shown)
EXPENSE_MAX_ITEM_AMOUNT=1000000          # upper sanity limit per line (₹)
EXPENSE_LATE_SUBMISSION_DAYS=90          # older lines need a late-submission reason
EXPENSE_TRIP_DATE_TOLERANCE_DAYS=1       # slack around trip/visit dates for line dates
EXPENSE_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,image/heic
EXPENSE_MAX_FILE_MB=10
EXPENSE_MAX_FILES_PER_ITEM=5
EXPENSE_STORAGE_DIR=./storage/expense-receipts   # private receipt storage (served only via /api/expense-attachments/:id)
EXPENSE_FALLBACK_APPROVER_ROLE=management         # approver when an employee has no active manager (management|admin)
EXPENSE_REMINDER_AFTER_DAYS=3            # daily 09:30 IST reminder for claims waiting longer than this
EXPENSE_EXPORT_BATCH_SIZE=1000           # rows per batch when streaming exports
